# Joy IP 3D 图片生成系统 - 环境变量配置示例

# =========================
# AI API 配置（后端运行时）
# =========================
# API 地址（默认值见 config.py；按你的供应商/网关调整）
AI_API_URL=https://modelservice.jdcloud.com/v1/responses
# API Key（不要把真实密钥提交到 Git）
AI_API_KEY=
# 默认模型
AI_MODEL=Gemini-3-Flash-Preview
# 可选：合并/分析专用模型（不填则沿用 AI_MODEL）
AI_ANALYSIS_MODEL=

# =========================
# Flask 配置
# =========================
DEBUG=false
HOST=0.0.0.0
PORT=28888
SECRET_KEY=change-me
CORS_ENABLED=false
CORS_ORIGINS=
OUTPUT_DIR=output
GENERATED_IMAGES_DIR=generated_images
DATA_DIR=data
IMAGE_QUALITY_CHECK=true

# =========================
# 模式配置
# =========================
# 单端口模式：由 Python 托管前端静态文件
SINGLE_PORT_MODE=true
# 前端静态文件目录
FRONTEND_BUILD_DIR=frontend_dist

# =========================
# 并发/超时/开关（可选）
# =========================
SCRIPT_TIMEOUT=120
MAX_RETRIES=3
MAX_PARALLEL_WORKERS=2
MAX_PARALLEL_WORKERS_2D=2
ENABLE_GATE_CHECK=1
GATE_CHECK_SCOPE=hats
DISABLE_CLIP_PRELOAD=
JD_IMG_SERIALIZE=1
JD_IMG_MIN_INTERVAL_S=0.8

# =========================
# 仅用于 test/ 下脚本的配置（可选）
# =========================
TEXT_MODEL_API_URL=https://modelservice.jdcloud.com/v1/chat/completions
TEXT_MODEL_API_KEY=
VITE_TEXT_MODEL_API_URL=https://modelservice.jdcloud.com/v1/chat/completions
VITE_TEXT_MODEL_API_KEY=
JIMENG_IMAGE_API_URL=https://modelservice.jdcloud.com/v1/imageEdit/generations
GEMINI_API_KEY=
VITE_GEMINI_IMAGE_API_URL=https://modelservice.jdcloud.com/v1/imageEdit/generations
VITE_GEMINI_API_KEY=
DOUBAO_IMAGE_API_KEY=
NEXT_PUBLIC_BACKEND_ORIGIN=http://127.0.0.1:6001

# =========================
# 日志配置
# =========================
LOG_LEVEL=INFO
LOG_FILE=logs/app.log
