# Joy IP 3D 图片生成系统 - 环境变量配置示例

# =========================
# AI API 配置（后端运行时）
# =========================
# API 地址（默认值见 config.py；按你的供应商/网关调整）
AI_API_URL=https://modelservice.jdcloud.com/v1/responses
# API Key（不要把真实密钥提交到 Git）
AI_API_KEY=
# 默认模型
AI_MODEL=Gemini-3-Flash-Preview
# 可选：合并/分析专用模型（不填则沿用 AI_MODEL）
AI_ANALYSIS_MODEL=

# =========================
# Flask 配置
# =========================
DEBUG=false
HOST=0.0.0.0
PORT=28888
SECRET_KEY=change-me
CORS_ENABLED=false
CORS_ORIGINS=
OUTPUT_DIR=output
GENERATED_IMAGES_DIR=generated_images
DATA_DIR=data
IMAGE_QUALITY_CHECK=true

# =========================
# 模式配置
# =========================
# 单端口模式：由 Python 托管前端静态文件
SINGLE_PORT_MODE=true
# 前端静态文件目录
FRONTEND_BUILD_DIR=frontend_dist

# =========================
# 并发/超时/开关（可选）
# =========================
SCRIPT_TIMEOUT=120
MAX_RETRIES=3
MAX_PARALLEL_WORKERS=2
MAX_PARALLEL_WORKERS_2D=2
ENABLE_GATE_CHECK=1
GATE_CHECK_SCOPE=hats
DISABLE_CLIP_PRELOAD=

# 任务队列（默认：保守；用于评估现网基线）
JOB_MAX_CONCURRENT=5
JOB_MAX_QUEUE_SIZE=50
JOB_TIME_BUDGET_S=600

# 4× 吞吐目标示例（按需打开）
# JOB_MAX_CONCURRENT=20
# JOB_MAX_QUEUE_SIZE=200

# 外部调用：并发/速率/超时（用于降低超时与429风暴）
HTTP_CONNECT_TIMEOUT_S=10
LLM_TEXT_MAX_CONCURRENT=8
LLM_TEXT_TIMEOUT_S=60
# Gemini(/v1/responses) 思考预算：过大可能导致输出被 MAX_TOKENS 截断；建议 16~64，默认 32；设为 0 则不发送该字段
LLM_THINKING_BUDGET=32

LLM_IMAGE_MAX_CONCURRENT=4
LLM_IMAGE_MIN_INTERVAL_S=0.2
LLM_IMAGE_TIMEOUT_S=60
LLM_IMAGE_MAX_RETRIES=2
LLM_IMAGE_RETRY_DELAY_S=2

GATE_MAX_CONCURRENT=4
GATE_MIN_INTERVAL_S=0
GATE_IMAGE_TIMEOUT_S=45
GATE_JUDGE_TIMEOUT_S=30
GATE_MODE=auto
GATE_JUDGE_MODEL=gpt-5

# 头像表情翻译（默认关闭大模型翻译，避免额外超时）
ENABLE_EXPR_LLM_TRANSLATION=0
EXPR_TRANSLATION_MODEL=doubao-seed-1.6-250615

# head 素材 CLIP 检索 query（默认启用：整段用户描述→英文短语(可补全)；失败自动回退到表情关键词方案）
ENABLE_HEAD_CLIP_QUERY_EN=1

# 兼容旧版脚本：默认开启串行锁（基线）；如要提升吞吐再关闭并启用 LLM_IMAGE_* 限流器
JD_IMG_SERIALIZE=1
JD_IMG_MIN_INTERVAL_S=0.0

# 4× 吞吐目标示例：
# JD_IMG_SERIALIZE=0

# =========================
# 仅用于 test/ 下脚本的配置（可选）
# =========================
TEXT_MODEL_API_URL=https://modelservice.jdcloud.com/v1/chat/completions
TEXT_MODEL_API_KEY=
VITE_TEXT_MODEL_API_URL=https://modelservice.jdcloud.com/v1/chat/completions
VITE_TEXT_MODEL_API_KEY=
JIMENG_IMAGE_API_URL=https://modelservice.jdcloud.com/v1/imageEdit/generations
GEMINI_API_KEY=
VITE_GEMINI_IMAGE_API_URL=https://modelservice.jdcloud.com/v1/imageEdit/generations
VITE_GEMINI_API_KEY=
DOUBAO_IMAGE_API_KEY=
NEXT_PUBLIC_BACKEND_ORIGIN=http://127.0.0.1:6001

# =========================
# 日志配置
# =========================
LOG_LEVEL=INFO
LOG_FILE=logs/app.log
